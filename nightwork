#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1-}" in
    sources|feedback)
        command=$1
        shift
        exec uv run --frozen --project "$root/plugin/skills/nightwork" python "$root/plugin/skills/nightwork/scripts/$command.py" "$@"
        ;;
esac
exec uv run --frozen --project "$root/plugin/skills/nightwork" python "$root/plugin/skills/nightwork/scripts/dream.py" "$@"
